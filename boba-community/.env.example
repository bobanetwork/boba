# L1 beacon chain RPC URL
ETH2_HTTP=

# optional
# op-reth client version
# Default: v2.2.1
RETH_VERSION=
# op-reth Docker image (override for locally built images)
# Default: us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth
# For local builds: RETH_IMAGE=localhost/op-reth
RETH_IMAGE=
# op-node version
# Default: v1.16.5
OP_NODE_VERSION=
# op-node Docker image (override for custom registries)
# Default: us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node (upstream OP Labs)
OP_NODE_IMAGE=
# Pre-bedrock historical RPC endpoint (legacy l2geth/OVM node)
# Used by op-reth to forward queries for blocks before the Bedrock migration.
# Default: the public Boba endpoint, which serves historical blocks but does
# not expose debug_* methods.
# If you run the bundled legacy node (--profile legacy), point this at the
# in-network service so op-reth forwards to your LOCAL replica instead of the
# public endpoint:
#   HISTORICAL_RPC=http://legacy-l2:8545
HISTORICAL_RPC=
# L1 RPC URL
# The default value is https://sepolia.gateway.tenderly.co
ETH1_HTTP=
# Data directory for op-reth (contains reth-data/)
# Default: current directory
DATA_DIR=

# --- Optional legacy node (l2geth, "legacy" profile, disabled by default) ---
# Only used when running with `--profile legacy`. Serves pre-Anchorage blocks.
# Data directory for the legacy l2geth database
# Default: ./legacy-data
LEGACY_DATA_DIR=
# Legacy L2 HTTP PORT
# Default: 8547 (op-reth uses 8545/8546)
LEGACY_L2_HTTP_PORT=
# Legacy L2 WS PORT
# Default: 8548
LEGACY_L2_WS_PORT=
